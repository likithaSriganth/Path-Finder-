# Career Compass AI - Environment Variables
# Copy this file to .env and update with your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string (optional for development - using in-memory storage by default)
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://admin:password123@localhost:5432/career_compass
# DATABASE_URL=postgresql://user:password@localhost:5432/career_compass

# ============================================
# SESSION CONFIGURATION
# ============================================
# Secret key for session encryption
# Generate a secure secret with: openssl rand -base64 32
# IMPORTANT: Change this in production!
SESSION_SECRET=your-super-secret-session-key-change-me-in-production

# ============================================
# SERVER CONFIGURATION
# ============================================
# Port for the server to listen on
PORT=3000

# Environment mode: development | production
NODE_ENV=development

# ============================================
# NOTES
# ============================================
# - In development: Database is optional (uses in-memory storage)
# - In production: DATABASE_URL is REQUIRED for data persistence
# - SESSION_SECRET: Use a strong, random value in production
# - Never commit .env file to version control
